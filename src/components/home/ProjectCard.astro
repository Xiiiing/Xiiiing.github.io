---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { HTMLTag, Polymorphic } from 'astro/types'

import { cn } from 'astro-pure/utils'

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  heading: string
  subheading: string
  imagePath: string
  altText?: string
  href?: string
  class?: string
}

const {
  as: Tag = 'a',
  class: className,
  href,
  heading,
  subheading,
  imagePath,
  altText
} = Astro.props
const interactive = Tag === 'a' && Boolean(href)
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<Tag
  class={cn(
    className,
    'project-card overflow-hidden relative flex flex-col justify-end rounded-2xl border bg-muted',
    interactive && 'project-card-link'
  )}
  href={href}
  target={interactive ? '_blank' : undefined}
  rel={interactive ? 'noopener noreferrer' : undefined}
>
  <Image
    src={images[imagePath]()}
    alt={altText ?? ''}
    class='project-card-image absolute w-full h-full object-cover'
    loading='lazy'
  />
  <div class='project-card-fg z-10 flex flex-col gap-y-0.5 px-5 pb-4 pt-36'>
    <div class='flex items-center justify-between gap-3'>
      <h3 class='text-lg font-medium'>{heading}</h3>
      {interactive && <span class='project-card-arrow' aria-hidden='true'>↗</span>}
    </div>
    <p class='text-muted-foreground'>{subheading}</p>
  </div>
  <slot />
</Tag>

<style>
  .project-card {
    color: hsl(var(--foreground));
  }

  .project-card-link {
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .project-card-link:focus-visible {
    border-color: hsl(var(--primary) / 0.55);
    box-shadow: 0 4px 14px hsl(var(--foreground) / 0.07);
  }

  .project-card-image {
    opacity: 0.6;
    transition: opacity 200ms ease;
  }

  :global(.dark) .project-card-image {
    opacity: 0.35;
  }

  .project-card-link:focus-visible .project-card-image {
    opacity: 1;
  }

  .project-card-arrow {
    flex-shrink: 0;
    color: hsl(var(--muted-foreground));
    font-size: 1.125rem;
    line-height: 1.5rem;
    transition: transform 200ms ease, color 200ms ease;
  }

  .project-card-link:focus-visible .project-card-arrow {
    color: hsl(var(--primary));
  }

  .project-card-fg {
    --un-gradient-shape: to bottom in oklch;
    --un-gradient: var(--un-gradient-shape), var(--un-gradient-stops);
    --un-gradient-from-position: 0%;
    --un-gradient-from: transparent var(--un-gradient-from-position);
    --un-gradient-to-position: 80%;
    --un-gradient-to: hsl(var(--card) / var(--un-to-opacity, 1)) var(--un-gradient-to-position);
    --un-gradient-stops: var(--un-gradient-from), var(--un-gradient-to);
    background-image: linear-gradient(var(--un-gradient));
  }

  .project-card-link:focus-visible .project-card-fg {
    --un-gradient-to-position: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card-link:hover {
      color: hsl(var(--foreground));
      border-color: hsl(var(--primary) / 0.45);
      box-shadow: 0 4px 14px hsl(var(--foreground) / 0.07);
    }

    .project-card-link:hover .project-card-image {
      opacity: 1;
    }

    .project-card-link:hover .project-card-fg {
      --un-gradient-to-position: 100%;
    }

    .project-card-link:hover .project-card-arrow {
      color: hsl(var(--primary));
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-card-link:hover {
      transform: translateY(-3px);
    }

    .project-card-link:hover .project-card-arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-card-link:focus-visible .project-card-arrow {
      transform: translate(2px, -2px);
    }
  }
</style>
