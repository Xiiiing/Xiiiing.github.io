---
import type { HTMLTag, Polymorphic } from 'astro/types'
import ProjectArtwork, { type ProjectKind } from './ProjectArtwork.astro'

import { cn } from 'astro-pure/utils'

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  heading: string
  subheading: string
  artwork: ProjectKind
  href?: string
  class?: string
}

const {
  as: Tag = 'a',
  class: className,
  href,
  heading,
  subheading,
  artwork
} = Astro.props
const interactive = Tag === 'a' && Boolean(href)
---

<Tag
  class={cn(
    className,
    'project-card overflow-hidden relative flex flex-col justify-end rounded-2xl border bg-muted',
    interactive && 'project-card-link'
  )}
  href={href}
  target={interactive ? '_blank' : undefined}
  rel={interactive ? 'noopener noreferrer' : undefined}
>
  <div class='project-card-artwork' aria-hidden='true'>
    <ProjectArtwork kind={artwork} />
  </div>
  <div class='project-card-fg z-10 flex flex-col gap-y-0.5 px-5 pb-4 pt-36'>
    <div class='flex items-center justify-between gap-3'>
      <h3 class='text-lg font-medium'>{heading}</h3>
      {interactive && <span class='project-card-arrow' aria-hidden='true'>↗</span>}
    </div>
    <p class='text-muted-foreground'>{subheading}</p>
  </div>
  <slot />
</Tag>

<style>
  .project-card {
    --project-surface: hsl(var(--muted));
    color: hsl(var(--foreground));
    background: var(--project-surface);
  }

  .project-card-link {
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .project-card-link:focus-visible {
    border-color: hsl(var(--primary) / 0.55);
    box-shadow: 0 4px 14px hsl(var(--foreground) / 0.07);
  }

  .project-card-artwork {
    position: absolute;
    inset: 0 0 auto;
    height: 10rem;
    pointer-events: none;
    background: radial-gradient(ellipse at 55% 25%, hsl(var(--primary) / 0.09), transparent 72%);
    opacity: 0.8;
    transition: opacity 200ms ease;
  }

  .project-card-link:focus-visible .project-card-artwork {
    opacity: 1;
  }

  .project-card-arrow {
    flex-shrink: 0;
    color: hsl(var(--muted-foreground));
    font-size: 1.125rem;
    line-height: 1.5rem;
    transition: transform 200ms ease, color 200ms ease;
  }

  .project-card-link:focus-visible .project-card-arrow {
    color: hsl(var(--primary));
  }

  .project-card-fg {
    --un-gradient-shape: to bottom in oklch;
    --un-gradient: var(--un-gradient-shape), var(--un-gradient-stops);
    --un-gradient-from-position: 40%;
    --un-gradient-from: transparent var(--un-gradient-from-position);
    --un-gradient-to-position: 80%;
    --un-gradient-to: var(--project-surface) var(--un-gradient-to-position);
    --un-gradient-stops: var(--un-gradient-from), var(--un-gradient-to);
    background-image: linear-gradient(var(--un-gradient));
  }

  .project-card-link:focus-visible .project-card-fg {
    --un-gradient-to-position: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card-link:hover {
      color: hsl(var(--foreground));
      border-color: hsl(var(--primary) / 0.45);
      box-shadow: 0 4px 14px hsl(var(--foreground) / 0.07);
    }

    .project-card-link:hover .project-card-artwork {
      opacity: 1;
    }

    .project-card-link:hover .project-card-fg {
      --un-gradient-to-position: 100%;
    }

    .project-card-link:hover .project-card-arrow {
      color: hsl(var(--primary));
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-card-link:hover {
      transform: translateY(-3px);
    }

    .project-card-link:hover .project-card-arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-card-link:focus-visible .project-card-arrow {
      transform: translate(2px, -2px);
    }
  }
</style>
