---
// Personal content in Astro Theme Pure's original homepage composition.
import { Image } from 'astro:assets'
import { Button, Icon, Label } from 'astro-pure/user'
import PageLayout from '../layouts/BaseLayout.astro'
import Section from '../components/home/Section.astro'
import ProjectCard from '../components/home/ProjectCard.astro'
import SkillLayout from '../components/home/SkillLayout.astro'
import NotePreview from '../components/home/NotePreview.astro'
import avatar from '../assets/avatar.jpg'
import { notes } from '../data/notes'
---

<PageLayout highlightColor='#659EB9'>
  <div class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header' aria-labelledby='profile-title'>
      <Image src={avatar} alt='Xiiiing 的猫咪头像' class='h-28 w-auto rounded-full border p-1' loading='eager' fetchpriority='high' />
      <div class='flex flex-col items-center gap-y-4'>
        <h1 id='profile-title' class='text-3xl font-medium'>Xiiiing</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3 text-sm sm:text-base'>
          <Label title='计算机视觉 · 医学影像'><Icon name='document' class='size-5' slot='icon' /></Label>
          <Label title='GitHub' as='a' href='https://github.com/Xiiiing'><Icon name='github' class='size-5' slot='icon' /></Label>
        </div>
      </div>
      <a href='/wiki/' class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'>
        <span class='relative flex items-center justify-center' aria-hidden='true'>
          <span class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75'></span>
          <span class='size-2 rounded-full bg-green-400'></span>
        </span>
        <span class='font-medium text-muted-foreground'>我的 Wiki · 持续记录中</span>
      </a>
    </section>

    <div id='content' class='animate flex w-full flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='关于我'>
        <p class='text-muted-foreground'>计算机硕士 / 计算机视觉与医学影像</p>
        <p class='leading-relaxed text-muted-foreground'>你好，我是 Xiiiing。关注数字病理、全切片图像与多实例学习，也记录开发、部署和算法学习中的实践。这里是我的个人主页，连接知识库与逐步积累的作品。</p>
        <Button title='更多关于我' class='w-fit self-end' href='/me/' variant='ahead' />
      </Section>

      <Section title='笔记选读'>
        <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
          {notes.map(note => <NotePreview note={note} />)}
        </ul>
        <Button title='浏览全部笔记' class='w-fit self-end' href='/wiki/' variant='ahead' />
      </Section>

      <Section title='我的空间'>
        <div class='grid grid-cols-1 gap-3 sm:grid-cols-2'>
          <ProjectCard href='/wiki/' heading='Wiki' subheading='研究笔记、工程实践与算法学习' imagePath='/src/assets/projects/1.avif' />
          <ProjectCard as='div' heading='UI 库 · 筹备中' subheading='界面效果、Prompt 与实现过程' imagePath='/src/assets/projects/2.avif' />
          <ProjectCard as='div' heading='Lab · 筹备中' subheading='小工具、可视化与交互实验' imagePath='/src/assets/projects/3.avif' />
          <ProjectCard href='/projects/' heading='项目与实践' subheading='查看项目介绍与源代码' imagePath='/src/assets/projects/4.avif' />
        </div>
      </Section>

      <Section title='技术与工具'>
        <SkillLayout title='语言' skills={['Python', 'JavaScript', 'Java']} />
        <SkillLayout title='工程' skills={['Git', 'Nginx', 'GitHub Actions']} />
        <SkillLayout title='学习' skills={['计算机视觉', 'Web 开发', '数据结构与算法']} />
      </Section>
    </div>
    <p class='mt-12 text-sm text-muted-foreground'>慢慢学，慢慢记。</p>
  </div>
</PageLayout>
