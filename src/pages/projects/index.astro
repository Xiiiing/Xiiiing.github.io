---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { Button, Card } from 'astro-pure/user'
import Section from '../../components/home/Section.astro'
---
<BaseLayout title='项目与实践' highlightColor='#659EB9'>
  <div class='mx-auto w-full md:w-4/5 lg:w-5/6'>
    <Button title='返回首页' href='/' variant='back' />
    <div id='content-header' class='animate mb-10 mt-6 flex flex-col gap-y-4'>
      <h1 class='text-3xl font-medium'>项目与实践</h1>
      <p class='text-muted-foreground'>知识整理、界面实践与小实验。</p>
    </div>
    <div id='content' class='animate flex flex-col gap-y-10'>
      <Section title='知识库'>
        <Card heading='Wiki' subheading='研究笔记 / 工程实践 / 算法学习'>
          <p class='leading-relaxed text-muted-foreground'>围绕计算机视觉和医学影像整理研究笔记，也记录开发、部署与算法学习。重点包括数字病理、全切片图像（WSI）与多实例学习（MIL）。</p>
          <div class='mt-2 flex flex-wrap gap-3'><Button title='浏览知识库' href='/wiki/' variant='ahead' /><Button title='源代码' href='https://github.com/Xiiiing/wiki' variant='ahead' /></div>
        </Card>
      </Section>
      <Section title='准备中的项目'>
        <Card heading='UI 库' subheading='筹备中'>
          <p class='leading-relaxed text-muted-foreground'>计划记录界面的真实效果、生成或实现它的 Prompt、关键代码，以及每一轮调整背后的判断。</p>
        </Card>
        <Card heading='Lab' subheading='筹备中'>
          <p class='leading-relaxed text-muted-foreground'>用于放置独立的小工具、数据可视化和交互实验。有了可以使用的作品，就在这里记录与分享。</p>
        </Card>
      </Section>
    </div>
  </div>
</BaseLayout>
